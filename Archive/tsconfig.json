{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": false,
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}